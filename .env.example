# CarePilot AI Environment Variables
# Copy this file to .env and fill in your values

# Application
APP_NAME=CarePilot AI
APP_VERSION=0.1.0
DEBUG=true
SECRET_KEY=your-secret-key-change-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Database
DATABASE_URL=sqlite:///./carepilot.db

# File Storage
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10
MAX_PDF_PAGES=50

# AI Provider (NVIDIA Nemotron)
AI_PROVIDER=demo  # demo or nemotron
NEMOTRON_API_URL=https://integrate.api.nvidia.com/v1/chat/completions
NEMOTRON_API_KEY=your-nemotron-api-key
NEMOTRON_MODEL=nvidia/nemotron-3-ultra

# Demo Mode Settings
DEMO_MODE=true
DEMO_AI_RESPONSE_DELAY_MS=500

# Security
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
SESSION_COOKIE_SECURE=false
CSRF_SECRET=your-csrf-secret-change-in-production